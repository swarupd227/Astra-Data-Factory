{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astra.artizent.com/schemas/glossary-v0.schema.json",
  "title": "Domain pack glossary, file version 0",
  "description": "The vocabulary of a domain pack. Entity terms define the canonical model's tables; concept terms define the words the pack uses around them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["glossary_version", "domain", "terms"],
  "properties": {
    "glossary_version": { "const": 0 },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "kind", "definition"],
        "properties": {
          "term": { "type": "string", "pattern": "^[A-Z][A-Za-z]*( [A-Za-z]+)*$" },
          "kind": { "enum": ["entity", "concept"] },
          "definition": { "type": "string", "minLength": 20 },
          "also": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Other names the term goes by in custodian documents." }
        }
      }
    }
  }
}
