{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astra.artizent.com/schemas/reference-data-v0.schema.json",
  "title": "Reference-data feeds, file version 0",
  "description": "The reference data a domain pack replicates into the platform on a schedule (a security master, an account cross-reference) so that resolution is a join, not a call: what each feed carries, how it is keyed, how it arrives, when it is expected, and which rejection codes resolution against it raises.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reference_data_version", "domain", "feeds"],
  "properties": {
    "reference_data_version": { "const": 0 },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "feeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "system", "description", "table", "key", "columns", "file", "schedule", "expected_every_hours", "resolves", "rejections"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
          "name": { "type": "string", "minLength": 3 },
          "system": { "type": "string", "minLength": 1, "description": "The source system of record, as the client names it." },
          "description": { "type": "string", "minLength": 20 },
          "table": { "$ref": "#/$defs/identifier", "description": "Replica table in the REFERENCE schema." },
          "key": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
          "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
          "file": {
            "type": "object",
            "additionalProperties": false,
            "required": ["folder"],
            "properties": {
              "folder": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "Folder under the reference prefix of the landing bucket where the system drops its snapshots." },
              "pattern": { "type": "string", "minLength": 1, "default": ".*[.]csv", "description": "Regular expression the snapshot file names match." },
              "columns_in_file_order": { "type": "boolean", "default": true, "description": "The file's columns are the feed's columns in order, after a header row." }
            }
          },
          "snapshot": { "enum": ["full"], "default": "full", "description": "Every delivery is the complete current state; the delta is computed against the replica." },
          "schedule": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cron", "timezone"],
            "properties": {
              "cron": { "type": "string", "pattern": "^[0-9*,/-]+ [0-9*,/-]+ [0-9*,/?-]+ [0-9A-Za-z*,/-]+ [0-9A-Za-z*,/?-]+$" },
              "timezone": { "type": "string", "minLength": 1 }
            }
          },
          "expected_every_hours": { "type": "integer", "minimum": 1, "maximum": 8760, "description": "A successful replication is expected at least this often; the alerting detector raises 'reference_stale' otherwise." },
          "stale_severity": { "enum": ["critical", "error", "warning"], "default": "error" },
          "resolves": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity"],
            "properties": {
              "entity": { "type": "string", "description": "Canonical entity resolved through this feed." },
              "identifiers": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/identifier" },
                "description": "Alternate identifier columns custodian records may carry, tried in this order. Without them, records resolve by the key."
              }
            }
          },
          "rejections": {
            "type": "object",
            "additionalProperties": false,
            "required": ["not_found", "ambiguous", "conflict"],
            "properties": {
              "not_found": { "$ref": "#/$defs/code" },
              "ambiguous": { "$ref": "#/$defs/code" },
              "conflict": { "$ref": "#/$defs/code" }
            },
            "description": "Taxonomy codes raised when resolution finds nothing, finds several rows, or the snapshot carries a key twice."
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,254}$" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,62}$" },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["string", "integer", "decimal", "date", "timestamp", "boolean"] },
        "precision": { "type": "integer", "minimum": 1, "maximum": 38 },
        "scale": { "type": "integer", "minimum": 0, "maximum": 37 },
        "required": { "type": "boolean", "default": false },
        "description": { "type": "string", "minLength": 1 },
        "pii": { "enum": ["raw_record", "name", "account_number", "tax_id", "email", "phone", "address", "date_of_birth", "financial"] },
        "codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "meaning"],
            "properties": { "value": { "type": "string", "minLength": 1 }, "meaning": { "type": "string", "minLength": 1 } }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "decimal" } } },
          "then": { "required": ["precision", "scale"] },
          "else": { "not": { "anyOf": [{ "required": ["precision"] }, { "required": ["scale"] }] } }
        }
      ]
    }
  }
}
