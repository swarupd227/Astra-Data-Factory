{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astra.artizent.com/schemas/source-spec-v0.schema.json",
  "title": "Astra Data Factory Source Spec, version 0",
  "description": "A machine-readable description of one custodian file layout (product spec Section 4): the records it contains, every field's position, picture and type, and where in the layout document each field is defined. One file per version, at specs/<id>/<version>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "spec", "document", "file", "records"],
  "properties": {
    "spec_version": { "const": 0 },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "effective_from", "file_type", "custodians"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier", "description": "Layout id, shared by every custodian that delivers this layout; the directory name." },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$", "description": "This version; the file name without extension." },
        "effective_from": { "$ref": "#/$defs/date", "description": "Business date from which this version is in force." },
        "file_type": { "$ref": "#/$defs/identifier", "description": "position, transaction, price, ..." },
        "custodians": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" }, "description": "Custodians that deliver files on this layout." },
        "family": { "$ref": "#/$defs/identifier", "description": "Layout family, assigned by the Pattern Matcher." },
        "provider": { "type": "string", "minLength": 1, "description": "Who publishes the layout, for example the clearing firm." },
        "description": { "type": "string" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "reference"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1, "description": "File name or URL of the layout document citations point into." },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pages": { "type": "integer", "minimum": 1 },
        "issued": { "$ref": "#/$defs/date" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "enum": ["fixed_width", "delimited"] },
        "record_length": { "type": "integer", "minimum": 1, "description": "Required for fixed_width." },
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 1, "description": "Required for delimited." },
        "quote": { "type": "string", "minLength": 1, "maxLength": 1, "description": "Field enclosure in a delimited file; default is a double quote." },
        "escape": { "type": "string", "minLength": 1, "maxLength": 1, "description": "Character that escapes a quote inside a quoted field. When absent, a quote is written twice." },
        "header_rows": { "type": "integer", "minimum": 0, "description": "Column-name rows to skip in a delimited file. The first is checked against field labels when they are declared." },
        "column_count": { "type": "integer", "minimum": 1, "description": "Number of columns every data row must have in a delimited file. A row with another count rejects the file." },
        "encoding": { "type": "string", "minLength": 1 },
        "line_ending": { "enum": ["lf", "crlf", "any"] }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "fields"],
        "properties": {
          "type": { "enum": ["header", "detail", "trailer"] },
          "name": { "$ref": "#/$defs/identifier", "description": "Required when a file has more than one detail record type." },
          "description": { "type": "string" },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "anyOf": [{ "required": ["position"] }, { "required": ["start", "end_marker"] }, { "required": ["column"] }],
            "properties": {
              "position": { "$ref": "#/$defs/position", "description": "Fixed-length record type token in a fixed-width file." },
              "start": { "type": "integer", "minimum": 1, "description": "With end_marker: the token starts here and runs up to the marker." },
              "end_marker": { "type": "string", "minLength": 1, "maxLength": 1, "description": "Character that ends the record type token." },
              "column": { "type": "integer", "minimum": 1, "description": "Delimited files: the column holding the record type." },
              "value": { "type": "string", "minLength": 1 }
            },
            "description": "How a line is recognised as this record type: a fixed-length token at a position, a token from a start position up to an end marker, or a column."
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/field" }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "length"],
      "properties": {
        "start": { "type": "integer", "minimum": 1, "description": "1-based first character" },
        "length": { "type": "integer", "minimum": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "citation"],
      "anyOf": [{ "required": ["picture"] }, { "required": ["type"] }],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "position": { "$ref": "#/$defs/position", "description": "Fixed-width files." },
        "column": { "type": "integer", "minimum": 1, "description": "Delimited files, 1-based." },
        "label": { "type": "string", "minLength": 1, "description": "Column heading as written in the header row of a delimited file; checked when header_rows is set." },
        "picture": { "type": "string", "pattern": "^S?[9XA]\\([1-9][0-9]*\\)(V9\\([1-9][0-9]*\\))?$", "description": "COBOL-style picture as written in the layout document." },
        "type": { "enum": ["string", "integer", "decimal", "date", "time", "code", "boolean"], "description": "Derived from the picture when omitted." },
        "format": { "type": "string", "minLength": 1, "description": "For dates and times, for example YYYYMMDD." },
        "sign_field": { "$ref": "#/$defs/identifier", "description": "Field in the same record that carries this number's sign." },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "citation": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [{ "required": ["page"] }, { "required": ["line"] }],
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "line": { "type": "integer", "minimum": 1 },
            "document": { "type": "string", "minLength": 1, "description": "When the citation is not into the spec's own document." }
          }
        },
        "codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "meaning"],
            "properties": {
              "value": { "type": "string" },
              "meaning": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
