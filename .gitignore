# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.auto.tfvars
*.auto.tfvars.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# Working output: astra-data, astra-verify and astra-agents all default to writing
# reports, drafts and rendered bundles under work/<command>/ — generated evidence, never
# committed. A draft this repository does want (a promoted spec, an exported evidence
# pack) is moved out of here by hand as part of that review.
work/

# Credentials and keys must never be committed
*.p8
*.pem
*.key
.env
.env.*

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
